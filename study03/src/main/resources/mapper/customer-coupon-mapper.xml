<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korai.study03.domain.customerCoupon.mapper.CustomerCouponMapper">

    <select id="findAll" resultType="com.korai.study03.domain.customerCoupon.entity.CustomerCoupon">
        select
            *
        from
            customer_coupons
        where
            customer_id = #{customerId}
    </select>


    <select id="findById" resultType="com.korai.study03.domain.customerCoupon.entity.CustomerCoupon">
        select
            *
        from
            customer_coupons
        where
            customer_coupon_id = #{customerCouponId}
    </select>


</mapper>
