<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korai.study03.domain.coupon.mapper.CouponMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="com.korai.study03.domain.coupon.entity.Coupon">
        insert into coupons
        values (
        default,
        #{code},
        #{name},
        #{discountType},
        #{discountValue},
        #{maxDiscount},
        #{minOrderAmount},
        #{validDays},
        #{isActive},
        #{createdAt}
        )
    </insert>
</mapper>

