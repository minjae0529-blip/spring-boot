<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korai.study03.domain.restaurant.mapper.RestaurantMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="restaurantId" parameterType="com.korai.study03.domain.restaurant.entity.Restaurant">

            insert into restaurants
            values (
        default,
        #{name},
        #{category},
        #{district},
        #{address},
        #{phone},
        #{minOrderAmount},
        #{deliveryFee},
        #{openTime},
        #{closeTime},
        #{openedAt},
        #{isOpen}
        )


    </insert>
</mapper>